// Club OS — data model
//
// Design notes:
//  - Multi-tenant by construction. Every business row hangs off a Club. No club
//    name is ever hardcoded in logic; "Exmoor" lives only in seed data.
//  - Money is stored as INTEGER CENTS everywhere (`*Cents` fields). Never floats.
//    The prototype tracked a running `mtdCharges` number on the member; here a
//    member's balance is derived by summing the MemberCharge ledger, so the
//    books can always be reconciled against the transactions that produced them.
//  - Stock lives in one Product table discriminated by StockLocation, so the pro
//    shop and the halfway house share a single POS engine instead of two.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- tenancy

model Club {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // Branding shown in the sidebar crest — the prototype hardcoded these.
  crest     String   @default("CO")
  markLine  String   @default("Club OS")
  footLine  String   @default("")
  timezone  String   @default("America/Chicago")
  createdAt DateTime @default(now())

  users       User[]
  members     Member[]
  caddies     Caddie[]
  products    Product[]
  sales       Sale[]
  holes       Hole[]
  maintLogs   MaintLogEntry[]
  teeSlots    TeeSlot[]
  lessons     Lesson[]
  charges     MemberCharge[]
  instructors Instructor[]
  courseDays  CourseDay[]
  events      Event[]
  tournaments Tournament[]
}

enum Role {
  GM
  HEAD_PRO
  PRO_SHOP
  CADDIE_MASTER
}

model User {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  ownedTasks EventTask[]

  // Scoped to the club so two clubs can each have their own pro@ address.
  @@unique([clubId, email])
  @@index([email])
}

// ---------------------------------------------------------------- members

enum MemberStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}

enum DuesStatus {
  CURRENT
  GRACE_PERIOD
  PAST_DUE
}

model Member {
  id             String       @id @default(cuid())
  clubId         String
  club           Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  household      String // "Whitfield, A. & M." — the billing unit
  membershipType String // Full Golf, Legacy, House Social, ...
  familySize     Int          @default(1)
  status         MemberStatus @default(ACTIVE)
  dues           DuesStatus   @default(CURRENT)
  handicap       String? // manual entry — no GHIN sync in this build
  email          String?
  phone          String?
  lastVisit      DateTime?
  createdAt      DateTime     @default(now())

  charges  MemberCharge[]
  teeSlots TeeSlot[]
  lessons  Lesson[]
  sales    Sale[]
  teams    TournamentTeam[]

  @@index([clubId, household])
}

enum ChargeSource {
  PRO_SHOP
  HALFWAY_HOUSE
  LESSON
  TOURNAMENT_PAYOUT
  MANUAL
}

/// The single ledger every module posts to. A member's month-to-date balance is
/// SUM(amountCents) over the current month — never a stored counter.
model MemberCharge {
  id          String       @id @default(cuid())
  clubId      String
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  source      ChargeSource
  description String
  amountCents Int
  postedAt    DateTime     @default(now())
  postedById  String?

  saleId   String? @unique
  sale     Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  lessonId String? @unique
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  payout   Payout?

  @@index([clubId, memberId, postedAt])
}

// ---------------------------------------------------------------- tee sheet

enum SlotStatus {
  OPEN
  BOOKED
  BLOCKED
}

enum PlayMode {
  CART
  WALKING
}

/// One row per tee time per day. Rows are generated on demand for a date and
/// then persist, so paging back and forth shows real bookings rather than the
/// prototype's synthetic preview.
model TeeSlot {
  id        String     @id @default(cuid())
  clubId    String
  club      Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  teeTime   String // "7:00am" — display form, ordered by sortKey
  sortKey   Int // minutes from midnight
  status    SlotStatus @default(OPEN)
  groupName String     @default("")
  memberId  String?
  member    Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  mode      PlayMode?
  caddieId  String?
  caddie    Caddie?    @relation(fields: [caddieId], references: [id], onDelete: SetNull)
  note      String     @default("")
  updatedAt DateTime   @updatedAt

  @@unique([clubId, date, sortKey])
  @@index([clubId, date])
}

// ---------------------------------------------------------------- caddies

enum CaddieStatus {
  AVAILABLE
  ON_LOOP
  OFF_TODAY
}

enum CaddieTier {
  LOOPER
  STANDARD
  TOURNAMENT
}

model Caddie {
  id        String       @id @default(cuid())
  clubId    String
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  tier      CaddieTier   @default(STANDARD)
  status    CaddieStatus @default(AVAILABLE)
  phone     String?
  createdAt DateTime     @default(now())

  teeSlots TeeSlot[]
  teams    TournamentTeam[]

  @@index([clubId, status])
}

// ---------------------------------------------------------------- inventory + POS

enum StockLocation {
  PRO_SHOP
  HALFWAY_HOUSE
}

model Product {
  id           String        @id @default(cuid())
  clubId       String
  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  location     StockLocation
  name         String
  category     String
  stock        Int           @default(0)
  reorderPoint Int           @default(0)
  priceCents   Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())

  lines SaleLine[]

  @@index([clubId, location])
}

enum TenderType {
  MEMBER_ACCOUNT
  CASH
}

model Sale {
  id         String        @id @default(cuid())
  clubId     String
  club       Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  location   StockLocation
  tender     TenderType
  memberId   String?
  member     Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  totalCents Int
  soldById   String?
  soldAt     DateTime      @default(now())

  lines  SaleLine[]
  charge MemberCharge?

  @@index([clubId, location, soldAt])
}

model SaleLine {
  id             String  @id @default(cuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPriceCents Int // captured at sale time — later price changes don't rewrite history
  lineTotalCents Int
}

// ---------------------------------------------------------------- lesson book

model Instructor {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  title     String   @default("Instructor")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  lessons Lesson[]

  @@index([clubId, active])
}

enum LessonStatus {
  OPEN
  BOOKED
  BLOCKED
}

model Lesson {
  id           String       @id @default(cuid())
  clubId       String
  club         Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  date         DateTime     @db.Date
  startTime    String // "8:00am"
  sortKey      Int
  instructorId String
  instructor   Instructor   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  status       LessonStatus @default(OPEN)
  memberId     String?
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  guestName    String       @default("") // non-member students
  lessonType   String       @default("")
  minutes      Int          @default(0)
  rateCents    Int          @default(0)
  charged      Boolean      @default(false)
  updatedAt    DateTime     @updatedAt

  charge MemberCharge?

  @@unique([clubId, date, instructorId, sortKey])
  @@index([clubId, date])
}

// ---------------------------------------------------------------- course

enum HoleStatus {
  OPEN
  CART_PATH_ONLY
}

enum PinPosition {
  A // front
  B // middle
  C // back
}

model Hole {
  id     String      @id @default(cuid())
  clubId String
  club   Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  number Int
  par    Int
  yards  Int
  status HoleStatus  @default(OPEN)
  pin    PinPosition @default(B)
  note   String      @default("")

  @@unique([clubId, number])
}

enum CourseStatus {
  OPEN
  RESTRICTED
  CLOSED
}

/// Course-wide status for one calendar day. Drives the status pill in the top
/// bar on every screen.
model CourseDay {
  id        String       @id @default(cuid())
  clubId    String
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  status    CourseStatus @default(OPEN)
  note      String       @default("")
  updatedAt DateTime     @updatedAt

  @@unique([clubId, date])
}

model MaintLogEntry {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  loggedAt  DateTime @default(now())
  label     String // "6:10a" — free-form so the crew can log "Mon" too
  text      String
  createdAt DateTime @default(now())

  @@index([clubId, loggedAt])
}

// ---------------------------------------------------------------- events

enum EventKind {
  TOURNAMENT
  PRIVATE_FUNCTION
  MEMBER_EVENT
}

model Event {
  id        String    @id @default(cuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  kind      EventKind @default(MEMBER_EVENT)
  date      DateTime  @db.Date
  detail    String    @default("") // "156 players · Shotgun 8:00a"
  location  String    @default("")
  createdAt DateTime  @default(now())

  tasks      EventTask[]
  tournament Tournament?

  @@index([clubId, date])
}

model EventTask {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sortKey   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([eventId, sortKey])
}

// ------------------------------------------------------------ tournament

enum PlayStatus {
  ACTIVE
  DELAYED
  SUSPENDED
  COMPLETE
}

model Tournament {
  id        String     @id @default(cuid())
  clubId    String
  club      Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  eventId   String?    @unique
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  name      String
  date      DateTime   @db.Date
  format    String     @default("")
  status    PlayStatus @default(ACTIVE)
  fieldSize Int        @default(0)

  flights   Flight[]
  groups    TeeGroup[]
  teams     TournamentTeam[]
  payouts   Payout[]
  messages  FieldMessage[]
  rulings   Ruling[]
  statusLog PlayStatusEntry[]
  sponsors  Sponsor[]

  @@index([clubId, date])
}

model Flight {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  sortKey      Int        @default(0)

  teams   TournamentTeam[]
  payouts Payout[]

  @@unique([tournamentId, name])
}

/// A starting group in a shotgun (or a tee time in a sequential start). Holds
/// the teams that go off together.
model TeeGroup {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  startHole    Int
  startTime    String // "8:00a"
  wave         String     @default("A")
  sortKey      Int        @default(0)

  teams TournamentTeam[]

  @@unique([tournamentId, wave, startHole])
  @@index([tournamentId, sortKey])
}

model TournamentTeam {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  flightId     String?
  flight       Flight?    @relation(fields: [flightId], references: [id], onDelete: SetNull)
  groupId      String?
  group        TeeGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name         String // "Whitfield / Marsh"
  memberId     String? // the member whose account any winnings credit
  member       Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  caddieId     String?
  caddie       Caddie?    @relation(fields: [caddieId], references: [id], onDelete: SetNull)
  thru         Int        @default(0)
  scoreToPar   Int        @default(0)
  reported     Boolean    @default(false) // has a score come in from the course yet
  updatedAt    DateTime   @updatedAt

  payouts Payout[]

  @@index([tournamentId, scoreToPar])
}

enum PayoutStatus {
  PENDING
  PAID
}

model Payout {
  id           String          @id @default(cuid())
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  flightId     String?
  flight       Flight?         @relation(fields: [flightId], references: [id], onDelete: SetNull)
  teamId       String?
  team         TournamentTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  place        String // "1st"
  amountCents  Int
  status       PayoutStatus    @default(PENDING)
  paidAt       DateTime?
  // Set once the winnings are credited to a member account, so paying twice
  // is impossible and the credit can be reversed with the payout.
  chargeId     String?         @unique
  charge       MemberCharge?   @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
}

enum MessageDelivery {
  LOGGED_ONLY
  SENT
}

/// A broadcast to the field. Composing and logging is real; actually sending
/// needs an SMS account, so delivery state records what really happened.
model FieldMessage {
  id           String          @id @default(cuid())
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  body         String
  delivery     MessageDelivery @default(LOGGED_ONLY)
  sentById     String?
  createdAt    DateTime        @default(now())

  @@index([tournamentId, createdAt])
}

model Ruling {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  hole         Int
  decision     String
  official     String
  loggedAt     DateTime   @default(now())

  @@index([tournamentId, loggedAt])
}

model PlayStatusEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  status       PlayStatus
  note         String     @default("")
  loggedAt     DateTime   @default(now())

  @@index([tournamentId, loggedAt])
}

model Sponsor {
  id            String     @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name          String
  tier          String     @default("Hole Sponsor")
  contactName   String     @default("")
  lastContactAt DateTime?
  note          String     @default("")

  @@index([tournamentId])
}
