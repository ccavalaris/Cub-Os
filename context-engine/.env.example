# Runtime connection.
#
# Local: one Postgres, one URL, and DIRECT_URL can stay commented out.
# Supabase: use the POOLED connection string (port 6543) here.
#
# NOTE the `schema=context_engine` parameter. This app keeps its tables in their
# own Postgres schema so it can share a database with another app — Club OS also
# defines `Member` and `Event` tables, and in a shared `public` schema the two
# would collide.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/context_engine?schema=context_engine"

# Migrations only, and only needed when DATABASE_URL is a POOLED connection
# (Supabase port 6543) — DDL cannot run through a transaction pooler. Left
# unset, migrations reuse DATABASE_URL.
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?schema=context_engine"

# Optional. With a key, note extraction and Ask the Course run on Claude.
# Without one, both fall back to a deterministic parser and the UI says so.
# ANTHROPIC_API_KEY="sk-ant-..."
